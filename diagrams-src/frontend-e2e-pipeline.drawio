        <mxCell id="gate" value="e2e-flow-registry 门禁&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;git diff → 业务域 → 查表&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
