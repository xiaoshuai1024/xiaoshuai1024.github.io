<mxfile host="app.diagrams.net">
  <diagram name="RNN与循环Transformer对比" id="gpta5">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="RNN：跨时间步复用权重" style="text;html=1;fontColor=#1e293b;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="440" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="隐藏状态&#10;h(t-1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="x1" value="token t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="230" width="110" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rnn" value="同一个 RNN 层&#10;（权重共享）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="160" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="隐藏状态&#10;h(t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="x2" value="token t+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="110" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="一次读一个 token&#10;前面的信息靠隐藏状态往前带&#10;循环方向 = 时间轴（横向）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="490" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="循环 Transformer：深度方向复用权重" style="text;html=1;fontColor=#1e293b;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="440" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="blk" value="Transformer 栈&#10;（22 个块，权重共享）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="150" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pass1" value="第 1 遍&#10;中间表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pass2" value="第 2 遍&#10;中间表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#2563eb;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="attn" value="token 之间仍靠注意力传递信息" style="text;html=1;fontColor=#475569;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="270" width="240" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="同一个 token 的中间表示&#10;多次通过同一个栈&#10;循环方向 = 架构深度（纵向）&#10;可理解为「权重共享版把模型做深」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="470" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="h1" target="rnn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="x1" target="rnn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="传给下一步" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="rnn" target="h2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;dashed=1;" edge="1" parent="1" source="h2" target="rnn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="x2" target="rnn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="进栈" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="pass1" target="blk">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="送回再过一遍" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;fontSize=11;fontColor=#2563eb;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="blk" target="pass2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
