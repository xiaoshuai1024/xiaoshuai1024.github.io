<mxfile host="app.diagrams.net">
  <diagram name="MCP连接对比" id="mcp1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ta" value="Claude Code v1.0.88：启动即全连" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="440" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="tb" value="Codex：按需懒连接 + prewarm" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="30" width="460" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="配置发现：用户级 + 项目 .mcp.json（L349510）&#10;项目级首次要过审批：enableAllProjectMcpServers /&#10;enabledMcpjsonServers / rejectedMcpjsonServers（L350779）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="80" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="启动时全部连接，tools/list 一次拉齐&#10;工具注入工厂 K2B（L386397）：&#10;name: mcp__服务器__工具 三段命名，isMcp: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="能力映射：readOnlyHint → 并发安全&#10;destructiveHint → 破坏性标记（L386413）&#10;发送前 HH0 过滤 MCP 专有块（L388701）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="300" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="acost" value="代价：启动时间随 server 数线性涨，工具描述全量占上下文" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="110" y="410" width="420" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="McpManager（core/src/mcp.rs:60）：configured /&#10;effective 两份名单，配置脏了才刷新（refresh_mcp_if_dirty）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="80" width="440" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="turn 开始时 required_mcp_servers_for_input：&#10;解析输入 mention 了哪些 server，只连需要的&#10;（session/mcp.rs :: runtime_mcp_config_and_context）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="170" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="prewarm 预热（session/mcp_prewarm.rs）：&#10;后台提前握手，真用到时省等待&#10;传输：stdio / streamable HTTP / 独立进程 / OAuth（rmcp-client）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="280" width="440" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="bcost" value="代价：首次触发有连接延迟；发现依赖输入文本里的 mention" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="630" y="390" width="440" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="fnote" value="「MCP 装多了变慢变挤」的病根：全连哲学下，装载成本是常驻的；懒连接哲学下是按次的。&#10;配置建议：天天用的核心 server 放 CC（永远在线），偶尔用的放 Codex（不用不付钱）。" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="160" y="470" width="860" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
