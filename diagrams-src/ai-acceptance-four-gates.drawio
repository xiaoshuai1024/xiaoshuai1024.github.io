<mxfile host="app.diagrams.net">
  <diagram name="四道契约闸" id="ac2">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="四道契约闸：守编译器不管的声明式跨层契约" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="36" width="560" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="gate1" value="闸一 URL ↔ 路由&#10;前端调的每个地址后端都要接得住" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gate2" value="闸二 SQL ↔ DDL&#10;Mapper 里的表必须在迁移脚本里建过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gate3" value="闸三 权限 key ↔ 种子数据&#10;代码引用的 key 必须注册过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="gate4" value="闸四 迁移版本号唯一&#10;两个 V12 撞号服务起不来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="and" value="「或」关系：任何一道红，整体红，不允许先提交后修复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="240" width="620" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="gate1" target="and">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="gate2" target="and">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="gate3" target="and">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="gate4" target="and">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="四个脚本合计不到 8 秒；pre-commit 发现 5 秒修好，线上发现就是事故复盘" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="620" height="20" as="geometry"/>
