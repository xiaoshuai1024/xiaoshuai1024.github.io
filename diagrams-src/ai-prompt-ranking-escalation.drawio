<mxfile host="app.diagrams.net">
  <diagram id="escalation" name="Page-1">
    <mxGraphModel dx="900" dy="360" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="崩溃升级链：一句话的三个阶段" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1e293b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="780" height="26" as="geometry" /></mxCell>
        <mxCell id="t2" value="语言学特征：句长随崩溃深度递减，敬语随崩溃深度归零" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="48" width="780" height="18" as="geometry" /></mxCell>
        <mxCell id="s1" value="「继续」" style="rounded=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#2563eb;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="s1d" value="第一阶：态度尚可，还把它当同事" style="text;html=1;fontSize=12;fontColor=#64748b;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="178" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="e1" value="被无视" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#94a3b8;endArrow=blockthin;endFill=1;fontSize=12;fontColor=#64748b;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="140" /></Array></mxGeometry></mxCell>
        <mxCell id="s2" value="「不对，重新来」" style="rounded=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#2563eb;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="110" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="s2d" value="第二阶：全盘否决，桌面清空重来" style="text;html=1;fontSize=12;fontColor=#64748b;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="178" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="e2" value="又不行" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#94a3b8;endArrow=blockthin;endFill=1;fontSize=12;fontColor=#64748b;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="140" /></Array></mxGeometry></mxCell>
        <mxCell id="s3" value="「算了，我自己来」" style="rounded=1;fillColor=#2563eb;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="s3d" value="第三阶：合作破产，人类亲自下场" style="text;html=1;fontSize=12;fontColor=#2563eb;align=center;" vertex="1" parent="1"><mxGeometry x="655" y="178" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="note" value="第三阶出现，意味着本次会话 AI 的工作成果为负数；它浑然不觉，还会贴心地问：「需要我为您总结刚才的修改要点吗？」" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="780" height="18" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
