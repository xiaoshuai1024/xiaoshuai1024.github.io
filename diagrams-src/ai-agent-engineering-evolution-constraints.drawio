        <mxCell id="d4" value="指令遵从率衰减&#10;规则从必守变仅供参考" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;fontStyle=1;" vertex="1" parent="1">
