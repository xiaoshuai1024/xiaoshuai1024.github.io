<mxfile host="app.diagrams.net">
  <diagram name="四个先天缺陷" id="constraints">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="大模型的四个先天缺陷" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="30" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="有输入就输出&#10;没人喊停就一直干" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d1note" value="需求只说半句就开写&#10;测试不过就改两行继续跑" style="text;html=1;align=center;fontColor=#64748b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="上下文窗口稀缺&#10;长任务必然掉质量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;fontStyle=1;" vertex="1" parent="1">
