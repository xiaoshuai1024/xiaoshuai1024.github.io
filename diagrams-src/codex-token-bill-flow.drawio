          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="输入只涨不降：第 1 轮 20,611 → 第 54 轮 226,262（同一任务）&#10;该会话总输入 952 万 token，总输出 6.6 万，输入:输出 = 144:1" style="text;html=1;align=left;vertical-align=middle;fontColor=#475569;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
