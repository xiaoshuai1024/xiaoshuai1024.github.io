        <mxCell id="i4" value="工具输出（读文件结果等）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="504" y="262" width="140" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="model" value="模型（无状态）&#10;对你的全部记忆 = 这一个请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="212" width="240" height="80" as="geometry"/>
