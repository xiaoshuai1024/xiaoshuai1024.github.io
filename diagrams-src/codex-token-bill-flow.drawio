<mxfile host="app.diagrams.net">
  <diagram name="每轮全量重发" id="flow1">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="you" value="你（终端）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="130" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="pack" value="Codex 打包器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#2563eb;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="系统提示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="348" y="214" width="140" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="i2" value="AGENTS.md（每轮计费）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="504" y="214" width="140" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="i3" value="前面所有轮次对话" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="348" y="262" width="140" height="34" as="geometry"/>
