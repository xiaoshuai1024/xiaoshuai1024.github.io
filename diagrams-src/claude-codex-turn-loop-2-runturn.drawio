<mxfile host="app.diagrams.net">
  <diagram name="run_turn三层" id="rt1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="turnBox" value="turn 级：run_turn（session/turn.rs:153）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="920" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="pre" value="准备工作：pre-turn compaction → MCP 依赖解析（按 mention 连接）&#10;→ skill/plugin 注入（build_skills_and_plugins）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="100" width="840" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="stepBox" value="step loop（turn.rs:281 起 loop{}）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="840" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="get_pending_input：取用户插话（steering）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="220" width="780" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="构造 sampling request → run_sampling_request（turn.rs:1322）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="280" width="780" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="消费 SSE 流：function call 一到就推入 in_flight（FuturesOrdered）&#10;工具边到边执行，结果按提交顺序回填（try_run_sampling_request @ turn.rs:2160）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="340" width="780" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="needs_follow_up = model_needs_follow_up || has_pending_input || token_limit_reached&#10;任一成立 → 再跑一轮 step（turn.rs:412）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="420" width="780" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="cancel" value="CancellationToken 贯穿全链&#10;每个 await 挂 or_cancel，取消即 TurnAborted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="420" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="hooks" value="turn 结束跑 stop hooks（turn.rs:484）&#10;流错误走 ResponsesStreamRetryState 重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="540" width="420" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" value="成立" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;fontSize=11;fontColor=#2563eb;dashed=1;" edge="1" parent="1" source="s4" target="s1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="448"/><mxPoint x="120" y="240"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="cap" value="循环的驱动不是「有没有工具调用」，是「模型还要不要继续」——工具执行只是 step 内部的一环。&#10;「抢跑感」来自最内层：流里的 function call 被当成可立即执行的指令，不是要攒齐的数据。" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="620" width="840" height="56" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
