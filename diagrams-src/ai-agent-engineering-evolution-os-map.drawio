<mxfile host="app.diagrams.net">
  <diagram name="操作系统映射" id="os-map">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="left" value="我补的工程能力" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
