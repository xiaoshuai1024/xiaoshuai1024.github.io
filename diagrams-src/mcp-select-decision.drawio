<mxfile host="app.diagrams.net">
  <diagram id="sel" name="选型决策">
    <mxGraphModel dx="800" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1000" pageHeight="490">
      <root>
        <mxCell id="0" />
