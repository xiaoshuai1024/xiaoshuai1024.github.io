        <mxCell id="l2" value="要碰浏览器调页面、跑 E2E&#10;Chrome DevTools MCP 或 Playwright MCP 二选一" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
