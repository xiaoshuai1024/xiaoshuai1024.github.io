        <mxCell id="b" value="/skill-test&#10;逐项测评打分&#10;产出：个人能力评分表.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13" vertex="1" parent="1">
