<mxfile host="app.diagrams.net">
  <diagram id="loop" name="系统总览">
    <mxGraphModel dx="800" dy="400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="四条命令接成一圈：每一条的输出，是下一条的输入" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#1e293b;fontStyle=1" vertex="1" parent="1">
