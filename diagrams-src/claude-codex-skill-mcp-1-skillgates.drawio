<mxfile host="app.diagrams.net">
  <diagram name="Codex skill 三段式" id="skill1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g1" value="发现层：loading.rs · load_roots 扫描各 skill 根目录&#10;LoadedSkillRoot 带快照缓存；parser.rs 解析 SKILL.md frontmatter&#10;格式错 → 连候选名单都进不了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="60" width="840" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="选择层：selection.rs 在候选里挑当前相关的&#10;skill 描述与任务的匹配度决定过不过这关&#10;（装上不等于用上的第一道闸）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="186" width="840" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="触发层：mentions.rs 认 @mention（提名字基本必触发）&#10;maybe_emit_implicit_skill_invocation（core/src/skills.rs:83）认隐式触发&#10;turn loop 的 build_skills_and_plugins 每 turn 重新评估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="312" width="840" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="inj" value="注入方式：context item（不是塞 system prompt）&#10;CC 2.x 同构：渐进披露——技能目录 → 点名加载正文 → references 按需读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="840" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="g3" target="inj"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cap" value="三道闸的设计动机：skill 描述占 token，全量注入等于给每个请求加税。&#10;用户唯一能优化的是 description——写「什么场景该想起我」，别写「我是什么」。" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="510" width="840" height="46" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
