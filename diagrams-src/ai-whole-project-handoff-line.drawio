<mxfile host="app.diagrams.net">
  <diagram name="放手判断线" id="apo2">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
