        <mxCell id="t" value="放手不是勇气问题，是验收能不能自动化的问题" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="560" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="没有测试，靠眼睛看&#10;→ 家规三条全开，别放手" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="有测试，盖住核心路径&#10;→ 整段整段写，人审接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="测试全 + 构建门禁 + 回滚&#10;→ 挂任务队列排队跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="110" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="上面都有，还跑过一段无事故&#10;→ 定时自治，只看报表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="110" width="240" height="60" as="geometry"/>
