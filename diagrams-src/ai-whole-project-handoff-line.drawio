          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lv" value="升级判据：这一级的验收已经稳定无聊了，才升下一级；出过事故就回退一级" style="text;html=1;fontSize=12;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="700" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="case" value="我现在的位置：第四档。视频管线夜间排队跑，封面缺失自动阻断发布，发布结果用只读工具逐平台回查——早上看的是报表，不是过程日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=left;" vertex="1" parent="1">
