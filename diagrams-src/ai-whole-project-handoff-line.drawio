        <mxCell id="eb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
