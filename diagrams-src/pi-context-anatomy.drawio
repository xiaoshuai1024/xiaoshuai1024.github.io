          <mxGeometry x="770" y="100" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ccnote" value="每一轮都背着同一份两万 token 前缀，命中缓存但决定最低消费" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1">
          <mxGeometry x="170" y="148" width="480" height="20" as="geometry"/>
