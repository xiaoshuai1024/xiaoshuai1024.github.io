        <mxCell id="ccsys" value="系统提示词 ≈ 20000 token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="100" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cctools" value="工具输出（原样进上下文）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
