          <mxGeometry x="460" y="230" width="70" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pinote" value="起点低 + 过程省：两个差距叠出「同模型换壳，账单差一倍」" style="text;html=1;fontSize=12;fontColor=#2563eb;align=left;" vertex="1" parent="1">
