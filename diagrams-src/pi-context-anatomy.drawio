        <mxCell id="pitools" value="工具输出（先过扩展裁剪，只留关键字段）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#93c5fd;strokeColor=none;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
