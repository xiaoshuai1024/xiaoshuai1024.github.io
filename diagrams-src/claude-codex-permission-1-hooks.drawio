<mxfile host="app.diagrams.net">
  <diagram name="CC权限决策流" id="perm1">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="call" value="工具调用进入执行管线（aN5 @ L417234）&#10;先过 inputSchema.safeParse 校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="640" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mode" value="模式轨：default / acceptEdits / bypassPermissions / plan&#10;allowedTools 规则语法带参数：Read(~/**)、Edit(~/.claude/settings.json)&#10;acceptEdits 白名单直通：mkdir touch rm rmdir mv cp（HP6 @ L378700）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="170" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="hook" value="hooks 轨：PreToolUse 事件&#10;hook 返回 permissionDecision:&#10;allow / deny / ask（三值改写）&#10;多 hook 并行执行（L407786）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="170" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="exec" value="执行工具，产出 tool_result&#10;决策痕迹：decisionReason { type: mode | hook }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="330" width="640" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="task" value="注意：Task 工具免权限（checkPermissions 直接 allow，L411591）&#10;守门在工具层不在派活层——拦得住工具调用，拦不住派一个带工具的 agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="440" width="900" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="events" value="九种 hook 事件：PreToolUse · PostToolUse · Notification · SessionStart · SessionEnd · Stop · SubagentStop · PreCompact · UserPromptSubmit（L350463–350471）" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="900" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="call" target="mode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="call" target="hook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="模式默认 + hook 改写，后者优先" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;fontColor=#1e293b;" edge="1" parent="1" source="mode" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="hook" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
