        <mxCell id="l1" value="「高级感」没有边界&#10;AI 每轮自己猜方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=14;fontColor=#1e293b;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="250" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="23 个色值 + 用色禁令&#10;AI 每轮在同一套数值里挑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=14;fontColor=#1e293b;strokeWidth=2;" vertex="1" parent="1">
