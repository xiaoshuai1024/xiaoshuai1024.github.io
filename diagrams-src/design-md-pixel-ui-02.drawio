        </mxCell>
        <mxCell id="r2" value="每一轮：同一套色值、同一套字号&#10;想跑偏也没有别的数可选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lv" value="风格漂移，每轮返工" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=14;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="95" y="410" width="200" height="40" as="geometry"/>
