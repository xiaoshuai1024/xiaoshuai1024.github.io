        <mxCell id="rv" value="风格锁定，改一处即可守" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#1e293b;fontSize=14;fontColor=#ffffff;" vertex="1" parent="1">
