        <mxCell id="l2" value="第一轮：极简白&#10;第二轮：紫色渐变&#10;第三轮：又换一个风格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
