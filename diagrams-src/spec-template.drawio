<mxfile host="app.diagrams.net">
  <diagram name="给 AI 读的 spec 骨架" id="t2tpl1">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1" value="背景与问题&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;两三句讲清为什么做&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="目标&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;做成什么样算完成，可判定陈述&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="非目标与边界&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;明确不做什么，防自作主张&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="验收标准&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;每条能变成一次运行、一个退出码&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="禁止事项&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;红线：不许动的目录、不许加的依赖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="开放问题&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;没想清楚的明说，让模型当变量而非自行填空&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="side1" value="没有记忆继承：&lt;br&gt;每次会话都是新人" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="side2" value="最容易踩的坑：&lt;br&gt;模型自作主张扩大战果" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="225" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="side3" value="语义判分误差大于信号：&lt;br&gt;写不成的条目别放验收区" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="300" width="250" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
