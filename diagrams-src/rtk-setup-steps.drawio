        <mxCell id="warn" value="hook 没挂上会一直打告警：看到告警先查挂载" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
