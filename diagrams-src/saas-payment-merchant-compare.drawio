<mxfile host="app.diagrams.net">
  <diagram name="直连商户vs服务商模式" id="pay-compare">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Left side title: 直连商户 -->
        <mxCell id="title1" value="模式一:直连商户(每个租户独立商户号)" style="text;html=1;align=center;fontColor=#1e293b;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="40" as="geometry" />
        </mxCell>

        <!-- Tenant A chain -->
        <mxCell id="ta1" value="租户A&#10;小程序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="amch" value="商户号A&#10;(绑定 AppId A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="abank" value="银行账户A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="280" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="ta1" target="amch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="amch" target="abank">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tenant B chain -->
        <mxCell id="tb1" value="租户B&#10;小程序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bmch" value="商户号B&#10;(绑定 AppId B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="190" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="bbank" value="银行账户B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="255" y="280" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="tb1" target="bmch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="bmch" target="bbank">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Annotation 1 -->
        <mxCell id="note1" value="资金流:用户→租户商户号→银行&#10;平台不经手资金&#10;合规最省心但租户入驻成本高" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#64748b;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- Divider -->
        <mxCell id="divider" value="" style="endArrow=none;html=1;strokeColor=#94a3b8;dashed=1;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="30" as="sourcePoint" />
            <mxPoint x="450" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Right side title: 服务商模式 -->
        <mxCell id="title2" value="模式二:服务商模式(平台统一收银)" style="text;html=1;align=center;fontColor=#1e293b;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="40" width="380" height="40" as="geometry" />
        </mxCell>

        <mxCell id="plat-app" value="租户A小程序&#10;租户B小程序&#10;(共用平台 AppId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="100" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="plat-mch" value="平台商户号&#10;(服务商身份)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#0f766e;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="195" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="submch" value="统一下单传入&#10;sub_mch_id=A&#10;sub_mch_id=B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="285" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tenant-accounts" value="微信结算系统&#10;按 sub_mch_id&#10;分到各租户银行账户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="625" y="380" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ep1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="plat-app" target="plat-mch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="plat-mch" target="submch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ep3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="submch" target="tenant-accounts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Annotation 2 -->
        <mxCell id="note2" value="资金流:用户→平台商户号→微信&#10;按 sub_mch_id 分到各租户&#10;租户0入驻但平台管资金流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#64748b;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="575" y="460" width="250" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>