        <mxCell id="a1c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="price" target="rounds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1l" value="抬高" style="edgeLabel;html=1;fontColor=#dc2626;fontSize=11;" vertex="1" connectable="0" parent="a1c"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry></mxCell>
        <mxCell id="a2c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="rounds" target="total"><mxGeometry relative="1" as="geometry"/></mxCell>
