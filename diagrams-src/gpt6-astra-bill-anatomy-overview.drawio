        <mxCell id="price" value="单价面（涨）&#10;&#10;输入 $10 / 输出 $50&#10;每百万 token&#10;上代的 2.5 倍&#10;输出价 = 输入价 × 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#1e293b;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="rounds" value="轮次机制（降）&#10;&#10;一次成型率高&#10;→ 返工少&#10;→ 轮次少" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="110" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="total" value="总账面（重活口径）&#10;&#10;比上一代低 43%&#10;比另一家旗舰低 86%&#10;省的不是单价，是轮次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#1e293b;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="280" height="150" as="geometry"/>
