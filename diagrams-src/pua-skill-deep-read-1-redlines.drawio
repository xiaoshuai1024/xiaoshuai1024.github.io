<mxCell id="r1" value="说「已完成」→ 必须贴验证输出&#10;没有输出的完成叫自嗨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="250" height="80" as="geometry"/></mxCell>
