        <mxCell id="E5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#2563eb;" edge="1" parent="1" source="MCP" target="HARNESS"><mxGeometry relative="1" as="geometry" /></mxCell>

