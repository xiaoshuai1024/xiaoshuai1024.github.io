<mxfile host="app.diagrams.net">
  <diagram name="AI 黑话主线" id="buzz-line">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
