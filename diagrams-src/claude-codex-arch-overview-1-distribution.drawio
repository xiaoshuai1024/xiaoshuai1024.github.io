          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="一边是闭源混淆、靠逆向和字符串锚点读；一边是开源工程、crate 名即目录名。&#10;读法不同，但都能读到agent 调度的核心逻辑。" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;whiteSpace=wrap;" vertex="1" parent="1">
