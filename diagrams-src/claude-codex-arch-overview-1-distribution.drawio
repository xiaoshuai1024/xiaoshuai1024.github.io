        </mxCell>
        <mxCell id="ccOld" value="v1.0.88（2025 年中）&#10;npm 包里就是一个 cli.js&#10;约 9MB，prettier 展开后 43 万行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="90" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ccNew" value="v2.1.229（2026-08 本机）&#10;npm 包里只剩 claude.exe&#10;307MB 原生 PE 二进制，JS 被编译进可执行文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="230" width="330" height="80" as="geometry"/>
