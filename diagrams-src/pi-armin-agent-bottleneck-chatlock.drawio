        <mxCell id="t1" value="同一个 Agent，两种存法：聊天记录 vs 数据库" style="text;html=1;fontSize=18;fontColor=#1e293b;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
