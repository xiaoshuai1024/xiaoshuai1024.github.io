        <mxCell id="r1" value="数据保持原始形态，不被对话改写" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;fontColor=#1e293b;align=left;spacingLeft=10;" vertex="1" parent="1">
