        <mxCell id="l1" value="记忆是弹性的、被处理过的" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=12;fontColor=#1e293b;align=left;spacingLeft=10;" vertex="1" parent="1">
