        <mxCell id="j4" value="定时任务 / 消息消费者&#10;状态驱动的下游都受波及" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=12;fontColor=#1e293b" vertex="1" parent="1">
