<mxfile host="app.diagrams.net">
  <diagram id="impact" name="影响分析两层">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="change" value="本次改动：新增部分退款&#10;（订单从「已支付/已退款」两态变三态）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#2563eb;fontSize=14;fontColor=#ffffff;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="layer1" value="直接影响（测试通常覆盖到）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;fontColor=#1e293b;verticalAlign=top;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="170" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="售后退款接口&#10;退多少钱记在售后模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;fontColor=#1e293b" vertex="1" parent="1">
          <mxGeometry x="155" y="210" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="订单状态枚举&#10;加了「部分退款」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;fontColor=#1e293b" vertex="1" parent="1">
          <mxGeometry x="385" y="210" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="退款页面与列表&#10;展示部分退款记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=12;fontColor=#1e293b" vertex="1" parent="1">
          <mxGeometry x="615" y="210" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="layer2" value="间接影响（看不见的调用方，测试最容易漏）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontSize=14;fontColor=#1e293b;verticalAlign=top;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="120" y="350" width="720" height="130" as="geometry" />
        </mxCell>
        <mxCell id="j1" value="佣金结算&#10;按订单状态驱动：&#10;「已支付」当成分文未退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=12;fontColor=#1e293b" vertex="1" parent="1">
          <mxGeometry x="140" y="395" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="j2" value="积分扣回&#10;只认「已退款」终态，&#10;部分退款不扣" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=12;fontColor=#1e293b" vertex="1" parent="1">
          <mxGeometry x="320" y="395" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="j3" value="经营报表&#10;收入按原金额统计，&#10;虚高" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=12;fontColor=#1e293b" vertex="1" parent="1">
          <mxGeometry x="500" y="395" width="150" height="70" as="geometry" />
