<mxfile host="app.diagrams.net">
  <diagram name="两个研究变体" id="gpta6">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="潜在推理 · Geiping 等（2025）：深度方向的循环" style="text;html=1;fontColor=#1e293b;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="head" value="2 个起始块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="90" width="120" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="proj" value="可学习线性投影&#10;拼接后进共享栈" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#2563eb;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="84" width="140" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="core" value="共享栈：4 个块&#10;循环 N 轮（训练时随机采样&#10;推理时人选预算 8 / 32 / 64 轮）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="190" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tail" value="2 个末尾块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="320" width="120" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="stop" value="自适应停止：相邻两轮下一 token 分布的&#10;KL 散度低于阈值就停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="230" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="每轮开始时，共享栈同时接收&#10;上一轮隐藏状态 + 起始块输出&#10;收益看任务：HellaSwag 约 8 轮趋平&#10;GSM8K / HumanEval 持续受益&#10;模型仍可生成文本思维链" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="480" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="全带宽 Transformer · Wang 等（2026）：跨 token 的循环" style="text;html=1;fontColor=#1e293b;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="480" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="tok1" value="token t-1&#10;最终隐藏状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="150" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="gate" value="可学习门控&#10;两者结合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="130" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="tok2" value="token t 嵌入&#10;（新采样）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="130" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="fwd" value="结合结果 = 下一次前向传播的输入&#10;下一个 token 从栈最底部&#10;就能拿到上一个 token 的最终表示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#2563eb;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="240" width="400" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="1B 基座模型：MATH500 上轨迹更短&#10;且保持甚至提升准确率&#10;但指令微调后缩短效应消失&#10;缺口：没测常规增大模型的影响&#10;也没确认更短轨迹忠实度是否更低" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="360" width="480" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="eg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="head" target="core">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eg2" value="每轮注入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;fontSize=11;fontColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proj" target="core">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eg3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="core" target="tail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eg4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;dashed=1;" edge="1" parent="1" source="stop" target="core">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ef1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="tok1" target="gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ef2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="tok2" target="gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ef3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;" edge="1" parent="1" source="gate" target="fwd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
