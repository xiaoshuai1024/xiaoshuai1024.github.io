<mxfile host="app.diagrams.net">
  <diagram name="两条计费路径" id="price01">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="同一份十万 token 历史，下一轮重发的两条计费路径" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="520" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="src" value="下一轮请求：重发十万 token 会话历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cmp" value="服务端前缀逐字节比对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="270" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="hit" value="开头完全一致：命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="hitp" value="折扣价 0.05 元 / 百万&#10;实付 0.005 元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="150" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="miss" value="中途一个字节变了：未命中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="380" width="220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="missp" value="原价 1.5 元 / 百万&#10;实付 0.15 元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="380" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="src" target="cmp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="一致" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;fontSize=11;fontColor=#2563eb;" edge="1" parent="1" source="cmp" target="hit">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="有改动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;fontColor=#64748b;" edge="1" parent="1" source="cmp" target="miss">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2563eb;" edge="1" parent="1" source="hit" target="hitp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="miss" target="missp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ratio" value="同一份历史，两种结局差 30 倍；会话 54 轮，就是 54 次二选一" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1">
          <mxGeometry x="520" y="490" width="480" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="src2" value="价目依据：DeepSeek v4-flash 输入两档，高峰时段各自翻倍、比值不动" style="text;html=1;fontSize=12;fontColor=#64748b;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="520" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
