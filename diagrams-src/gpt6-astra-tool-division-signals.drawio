        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;" edge="1" parent="1" source="s1" target="go"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;" edge="1" parent="1" source="s2" target="go"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16a34a;" edge="1" parent="1" source="s3" target="go"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="基准逼近满分后区分度归零，任务集重放是唯一可信判据（自测方法见跑分分层一篇）" style="text;html=1;align=center;fontColor=#64748b;fontSize=11;" vertex="1" parent="1">
