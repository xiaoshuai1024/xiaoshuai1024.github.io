          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="bad" value="差的那条「给 field-library 模块加测试」：四件套只有目标一件，空出来的三件 AI 全用猜测填上" style="text;html=1;fontSize=12;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="56" y="220" width="560" height="40" as="geometry"/>
