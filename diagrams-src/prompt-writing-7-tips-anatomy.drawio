          <mxGeometry x="56" y="26" width="420" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="prompt" value="「给 costcenter-web 的 field-library 模块加单测，&#10;覆盖动态字段排序，先用真实配置确认现有行为，&#10;再补测试，跑到全绿」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="56" y="70" width="560" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="① 目标：加单测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="66" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="② 上下文：哪个项目 · 覆盖什么行为" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="③ 验收：确认现状 · 跑到全绿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#2563eb;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="174" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="④ 边界：真实配置，不用 mock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="228" width="200" height="40" as="geometry"/>
