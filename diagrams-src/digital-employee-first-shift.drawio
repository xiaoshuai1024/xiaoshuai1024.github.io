        <mxCell id="n7" value="执行者 B:Claude Code(通用 agent,读同一张工单自己干)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#475569;fontSize=12;dashed=1;" vertex="1" parent="1">
