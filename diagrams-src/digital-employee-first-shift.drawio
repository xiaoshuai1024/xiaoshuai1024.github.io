        <mxCell id="n6" value="执行者 A:agent_recon.py(程序化数字员工,0.003 秒)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#475569;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="290" height="46" as="geometry"/>
