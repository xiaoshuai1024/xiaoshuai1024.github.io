          <mxGeometry x="540" y="220" width="150" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="n3b" value="流水 ↔ 订单&#10;重复 / 差额 / 状态矛盾" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="715" y="220" width="150" height="58" as="geometry"/>
