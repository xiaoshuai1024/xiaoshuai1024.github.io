        <mxCell id="n3c" value="合同条款&#10;返利与折扣重算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="220" width="150" height="58" as="geometry"/>
