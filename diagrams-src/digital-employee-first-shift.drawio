<mxfile host="app.diagrams.net">
  <diagram id="recon-flow" name="数字员工对账执行流程">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="工单 TASK.md&#10;(自然语言派活)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="180" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="读四张表&#10;订单 / 账单 / 流水 / 合同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="345" y="90" width="200" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="三维核对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
