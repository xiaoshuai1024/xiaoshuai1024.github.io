        <mxCell id="n5" value="对账报告 recon_report.md&#10;(摘要 + 逐笔差异 + 建议)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1110" y="90" width="190" height="64" as="geometry"/>
