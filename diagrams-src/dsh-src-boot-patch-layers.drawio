        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;fontSize=11;" edge="1" parent="1" source="merged" target="loader">
          <mxGeometry relative="1" as="geometry"/>
