<mxfile host="app.diagrams.net">
  <diagram name="Writer-Reviewer 双上下文" id="qg2">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="一个写一个查：上下文分开，盲区才藏不住" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="56" y="26" width="520" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="writer" value="实现会话（Writer）&#10;上下文里装着：&#10;· 需求与设计取舍&#10;· 历史尝试与废弃方案&#10;· 每行代码的「为什么」&#10;&#10;看得见合理性，看不见盲区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="56" y="80" width="260" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="reviewer" value="评审会话（Reviewer）&#10;干净上下文，只读 diff：&#10;· 这份改动会怎么碎&#10;· 有没有对应测试&#10;· 边界条件、既有约定冲突&#10;&#10;没有「为什么」，只看「是什么」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#2563eb;fontColor=#ffffff;fontSize=12;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="260" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="diff" value="diff +&#10;问题清单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e293b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="378" y="132" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="产出" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2563eb;fontSize=11;fontColor=#1e293b;" edge="1" parent="1" source="writer" target="diff">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="退回修改" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2563eb;fontSize=11;fontColor=#1e293b;dashed=1;" edge="1" parent="1" source="diff" target="writer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="只读" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#2563eb;fontSize=11;fontColor=#1e293b;" edge="1" parent="1" source="diff" target="reviewer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="key" value="两个会话互不进入对方上下文，中间只传 diff 和问题清单&#10;第一道关卡：没有对应测试 → 直接退回，其余不看" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#2563eb;align=left;" vertex="1" parent="1">
          <mxGeometry x="56" y="300" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="warn" value="同一会话里「再检查一遍」不算评审：同上下文的盲区会原样复刻" style="text;html=1;fontSize=12;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="56" y="356" width="520" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
