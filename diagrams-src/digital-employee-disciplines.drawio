<mxfile host="app.diagrams.net">
  <diagram name="三条家规因果链" id="disc01">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="三条家规通向同一个结果" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="36" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="家规一：日志只追加，不改写&#10;（改一处，身后全部按原价重来）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="250" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="家规二：上下文能不动就不动&#10;（文档稳定期上锁，改动集中批量）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="250" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="家规三：前缀源头不乱动&#10;（装插件、切模式排到任务边界）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="250" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="mid" value="每一轮请求的前缀&#10;逐字节稳定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="215" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="hit" value="缓存命中率上去了&#10;（自家长会话 92%–98%，dsh 第三方横测约 99.93%）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="130" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pay" value="同一份工作，实付差到 30 倍：&#10;折扣从抽奖结果变成固定收益" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="330" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="r1" target="mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="r2" target="mid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#64748b;" edge="1" parent="1" source="r3" target="mid">
          <mxGeometry relative="1" as="geometry"/>
