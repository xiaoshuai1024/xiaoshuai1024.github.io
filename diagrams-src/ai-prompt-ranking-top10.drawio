        <mxCell id="n10" value="「请说人话」" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1"><mxGeometry x="94" y="83" width="200" height="26" as="geometry" /></mxCell>
