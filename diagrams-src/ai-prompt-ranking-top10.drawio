        <mxCell id="n7" value="「你确定吗？」" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1"><mxGeometry x="94" y="269" width="200" height="26" as="geometry" /></mxCell>
