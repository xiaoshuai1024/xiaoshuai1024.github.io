        <mxCell id="n4" value="「一次完成，中途不要停止」" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e293b;align=left;" vertex="1" parent="1"><mxGeometry x="94" y="455" width="200" height="26" as="geometry" /></mxCell>
